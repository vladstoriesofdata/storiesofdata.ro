---
import { getSiteConfig, withBase } from "../lib/site";
import Seo from "../components/Seo.astro";
import CookieBanner from "../components/CookieBanner.astro";
import Analytics from "../components/Analytics.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import "../styles/chrome.css";
import "../styles/legacy-work.css";
import "../styles/legacy-content.css";

type Chrome = "home" | "work" | "doc";

interface Props {
  title: string;
  description: string;
  path: string;
  robots?: string;
  chrome?: Chrome;
}

const { title, description, path, robots, chrome = "doc" } = Astro.props;
const site = getSiteConfig(import.meta.env);
---
<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={withBase("/favicon.jpg", import.meta.env.BASE_URL)} type="image/jpeg" />
    <Seo title={title} description={description} path={path} robots={robots} />
    <CookieBanner />
    <Analytics />
  </head>
  <body data-chrome={chrome}>
    <Header path={path} chrome={chrome} />
    <main>
      <slot />
    </main>
    {chrome === "doc" && <Footer />}
  </body>
</html>
