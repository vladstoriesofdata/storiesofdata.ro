---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  path: string;
  contentClass?: string;
}

const { title, description, path, contentClass } = Astro.props;
---
<BaseLayout title={title} description={description} path={path} chrome="work">
  <div class:list={["work-content", contentClass]}>
    <slot />
  </div>
</BaseLayout>
