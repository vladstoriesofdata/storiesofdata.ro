---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/home/Hero.astro";
import Services from "../components/home/Services.astro";
import PortfolioStrip from "../components/home/PortfolioStrip.astro";
import Team from "../components/home/Team.astro";
import Testimonials from "../components/home/Testimonials.astro";
import ContactForm from "../components/ContactForm.astro";
import LottieGraphic from "../components/home/LottieGraphic.astro";
import { getSiteConfig, withBase } from "../lib/site";
import { home } from "../data/home";
import steps from "../assets/lottie/steps-1-2-3-4-5.json?url";
import logoWhite from "../assets/brand/logo-white.svg";
import iconEmail from "../assets/brand/icon-email.svg";
import iconPhone from "../assets/brand/icon-phone.svg";

const site = getSiteConfig(import.meta.env);
const copy = home[site.locale];
---
<BaseLayout title={copy.title} description={copy.description} path="/" chrome="home">
  <div class="background-anim-wrapper" aria-hidden="true">
    <LottieGraphic src={steps} loop={false} autoplay={false} scrub={true} />
  </div>
  <Hero />
  <Services />
  <PortfolioStrip />
  <Team />
  <Testimonials />
  <section
    id="contact"
    class="section home-section contact-section"
    data-section-name="contact"
    aria-labelledby="contact-heading"
  >
    <div class="contact-grid">
      <div class="contact-copy">
        <p class="contact-kicker">{copy.contact.heading}</p>
        <h2 id="contact-heading" class="contact-heading">{copy.contact.subheading}</h2>
        <p class="contact-body">{copy.contact.body}</p>
        <img
          class="contact-logo"
          src={logoWhite.src}
          alt={site.name}
          width={logoWhite.width}
          height={logoWhite.height}
        />
      </div>
      <div class="contact-panel">
        <div class="contact-channels">
          <a class="contact-channel" href={`mailto:${copy.contact.email}`}>
            <img src={iconEmail.src} alt="" width="25" height="25" />
            {copy.contact.email}
          </a>
          <a class="contact-channel" href={`tel:${copy.contact.phoneHref}`}>
            <img src={iconPhone.src} alt="" width="25" height="25" />
            {copy.contact.phone}
          </a>
        </div>
        <ContactForm />
        <nav class="contact-legal" aria-label="Legal">
          <a href={withBase("/privacy-policy", import.meta.env.BASE_URL)}>Privacy policy</a>
          <a href={withBase("/terms-and-conditions", import.meta.env.BASE_URL)}>Terms</a>
          <p class="contact-copyright">© Stories of Data 2026</p>
        </nav>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-copyright {
    margin: 0 0 0 auto;
    color: var(--color-paper);
    font-family: var(--font-display);
    font-size: 10px;
  }
</style>

<script>
  import { initHomepageSnap } from "../components/home/SectionSnap";
  import { initTabs } from "../components/home/Tabs";
  import { initCarousel } from "../components/home/Carousel";
  initHomepageSnap();
  initTabs();
  initCarousel();
</script>

