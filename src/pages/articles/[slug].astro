---
import { getCollection, render } from "astro:content";
import { getSiteConfig } from "../../lib/site";
import {
  adjacentNav,
  byPubDateDesc,
  entrySlug,
  isLocaleEntry,
  pagerKindLabel,
} from "../../lib/collections";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import UntranslatedBanner from "../../components/UntranslatedBanner.astro";
import PostPager from "../../components/work/PostPager.astro";

export async function getStaticPaths() {
  const site = getSiteConfig(import.meta.env);
  const entries = await getCollection("articles", (entry) =>
    isLocaleEntry(entry.id, site.locale),
  );
  const ordered = byPubDateDesc(entries);
  return entries.map((entry) => ({
    params: { slug: entrySlug(entry.id) },
    props: {
      entry,
      nav: adjacentNav(ordered, entry.id, "/articles"),
      kindLabel: pagerKindLabel("articles", site.locale),
    },
  }));
}

const { entry, nav, kindLabel } = Astro.props;
const { Content } = await render(entry);
const path = `/articles/${entrySlug(entry.id)}`;
---
<ArticleLayout title={entry.data.title} description={entry.data.description} path={path} contentClass="work-article">
  {entry.data.translationStatus === "untranslated" && <UntranslatedBanner />}
  <h1 class="visually-hidden">{entry.data.title}</h1>
  <Content />
  {nav && <PostPager nav={nav} kindLabel={kindLabel} />}
</ArticleLayout>
