---
import { getSiteConfig } from "../lib/site";
import logoBlack from "../assets/brand/logo-black.svg";

const site = getSiteConfig(import.meta.env);
---
<footer>
  <a href="/" class="brand">
    <img
      src={logoBlack.src}
      alt={site.name}
      width={logoBlack.width}
      height={logoBlack.height}
    />
  </a>
  <nav>
    <a href="/privacy-policy">Privacy policy</a>
    <a href="/terms-and-conditions">Terms</a>
  </nav>
  <p class="copyright">© Stories of Data 2026</p>
</footer>

<style>
  .brand img {
    display: block;
    height: 2.25rem;
    width: auto;
  }

  .copyright {
    flex-basis: 100%;
    margin: 0;
    color: inherit;
    font-family: var(--font-display);
    font-size: 10px;
    text-align: right;
  }
</style>
