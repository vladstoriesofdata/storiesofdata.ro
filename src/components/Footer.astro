---
import { getSiteConfig, withBase } from "../lib/site";
import { ui } from "../data/ui";
import logoBlack from "../assets/brand/logo-black.svg";

const site = getSiteConfig(import.meta.env);
const copy = ui[site.locale];
const homeHref = withBase("/", import.meta.env.BASE_URL);
---
<footer>
  <a href={homeHref} class="brand">
    <img
      src={logoBlack.src}
      alt={site.name}
      width={logoBlack.width}
      height={logoBlack.height}
    />
  </a>
  <nav>
    <a href={withBase("/privacy-policy", import.meta.env.BASE_URL)}>{copy.privacyPolicy}</a>
    <a href={withBase("/terms-and-conditions", import.meta.env.BASE_URL)}>{copy.terms}</a>
  </nav>
  <p class="copyright">© Stories of Data 2026</p>
</footer>

<style>
  .brand img {
    display: block;
    height: 2.25rem;
    width: auto;
  }

  .copyright {
    flex-basis: 100%;
    margin: 0;
    color: inherit;
    font-family: var(--font-display);
    font-size: 10px;
    text-align: right;
  }
</style>
