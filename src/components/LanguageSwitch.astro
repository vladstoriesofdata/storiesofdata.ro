---
import { getSiteConfig, peerUrl } from "../lib/site";

interface Props {
  path: string;
}

const { path } = Astro.props;
const site = getSiteConfig(import.meta.env);
const pair = [
  { locale: "en" as const, label: "EN" },
  { locale: "ro" as const, label: "RO" },
];
---
<div class="language-switch">
  {pair.map((item) => {
    if (item.locale === site.locale) {
      return <span aria-current="true">{item.label}</span>;
    }
    const ariaLabel = item.locale === "ro" ? "Switch to Romanian" : "Switch to English";
    return (
      <a href={peerUrl(path, site)} hreflang={item.locale} aria-label={ariaLabel}>
        {item.label}
      </a>
    );
  })}
</div>
