---
import type { Locale } from "../../lib/site";
import SystemIntegrationAnimation from "./SystemIntegrationAnimation.astro";
interface Props { card: number; option: number; locale: Locale; }
const { card, option, locale } = Astro.props;
const ro = locale === "ro";
const key = `${card}-${option}`;
const metrics = [ro ? "Marja Brută" : "Gross Margin", "CAGR", "Contribution Margin", "Cash Conversion Cycle", "EBITDA %", "Free Cash Flow", "ROE", "ROA", "Current ratio", "Net Debt/EBITDA", ro ? "Acoperirea dobânzii" : "Interest coverage", "Quick ratio"];
const specialised = ro ? ["Benchmark analysis", "Controlul cash-ului", "Politici de prețuri", "Modele de ofertare", "Rotația stocurilor", "Modele de calcul ale bonusurilor"] : ["Benchmark analysis", "Cash control", "Pricing policies", "Quotation models", "Inventory turnover", "Bonus calculations"];
const questions = ro ? ["De ce încă investiți în produsul acesta neprofitabil?", "De unde se pot tăia costuri pentru a reține profituri?", "Cât ar trebui investit pentru a câștiga 1% în plus din piață?"] : ["Why are you still investing in this unprofitable product?", "Where can costs be cut to retain more profit?", "What investment would win another 1% of the market?"];
const enrichment = ro ? ["Entity resolution", "Normalizare de date", "Clasificare de date", "Atribuire de date"] : ["Entity resolution", "Data normalisation", "Data classification", "Data attribution"];
const positions = [[110,38], [320,38], [340,105], [320,175], [110,175], [100,105]];
---
<div class="animation" data-option-visual={option} data-animation={key} hidden={option !== 0} aria-hidden="true">
  {key === "0-0" && <div class="cloud">{metrics.map((metric, i) => <span class:list={{major:i>=4 && i<=6}} style={`--delay:${i*70}ms;--float-delay:${i*-.3}s`}>{metric}</span>)}</div>}
  {key === "0-1" && <div class="reports">{["Balance Sheet", "P&L", "Cash Flow"].map((name,i) => <div class="report" style={`--delay:${i*150}ms`}><div class="sheet">{[70,45,60,50].map((width,j) => <i style={`width:${width}%;--delay:${i*150+j*80}ms`}></i>)}</div><small>{name}</small></div>)}</div>}
  {key === "0-2" && <svg viewBox="0 0 440 210"><g class="lines">{positions.map(([x,y]) => <path d={`M220 105L${x} ${y}`} />)}</g><circle cx="220" cy="105" r="6" fill="#14213d"/>{specialised.map((name,i) => <g class="enter" style={`--delay:${i*90}ms`}><circle cx={positions[i][0]} cy={positions[i][1]} r="4" fill="#e8b93f"/><text x={positions[i][0]} y={positions[i][1]+(i===2 || i===5 ? 22 : i<2 ? -13 : 23)} text-anchor="middle">{name}</text></g>)}<circle class="orbit" cx="220" cy="105" r="5" fill="#1f7a5c"/></svg>}
  {key === "1-0" && <svg class="person" viewBox="0 0 160 110"><circle cx="62" cy="32" r="16" fill="#14213d"/><path d="M26 103c0-32 15-48 36-48s36 16 36 48" fill="#14213d"/>{[0,1,2].map(i => <circle class="ring" style={`animation-delay:${i*.7}s`} cx="115" cy="33" r="14" fill="none" stroke="#e8b93f"/>)}<circle cx="115" cy="33" r="15" fill="#fbf7ee"/><path d="M105 22c-7 10 9 27 19 21l-4-7-6 3-6-8 3-5z" fill="none" stroke="#14213d" stroke-width="2"/></svg>}
  {key === "1-1" && <div class="cycle questions">{questions.map((text,i) => <p style={`--cycle-delay:${i*3.2}s;--cycle-duration:9.6s`}>{text}</p>)}</div>}
  {key === "1-2" && <div class="checklist">{[0,1,2,3].map(i => <div><svg viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="4" fill="white" stroke="#dcddd6"/><path class="check" style={`animation-delay:${i*.55}s`} d="M6 12l4 5 8-10" fill="none" stroke="#1f7a5c" stroke-width="2" pathLength="1"/></svg><i></i></div>)}</div>}
  {key === "2-0" && <div class="data-quality">{[
    [ro ? "Nume similare" : "Similar names", "SC Alpha SRL", "Alpha S.R.L.", "ALPHA Srl"],
    [ro ? "Duplicate" : "Duplicates", "Client #10234", "Client #10234", "Client #10234"],
    [ro ? "Valori lipsă" : "Missing values", ro ? "Nume: —" : "Name: —", ro ? "Cod fiscal: —" : "Tax code: —", "Email: —"],
  ].map(([label,...rows],i) => <div class="quality-piece enter" style={`--delay:${i*150}ms`}><div class:list={{warning:i>0}}>{rows.map(row => <span>{row}</span>)}</div><small>{label}</small></div>)}</div>}
  {key === "2-1" && <div class="cycle enrichment">{enrichment.map((text,i) => <p style={`--cycle-delay:${i*2.6}s;--cycle-duration:10.4s`}>{text}</p>)}</div>}
  {key === "2-2" && <SystemIntegrationAnimation locale={locale} />}
  {key === "3-0" && <svg viewBox="0 0 440 210"><g class="lines">{[80,220,360].map(x => <><path d={`M${x} 35L220 85`}/><path d={`M220 120L${x} 175`}/></>)}</g>{["ERP","CRM",ro ? "Alte surse de date" : "Other data sources"].map((label,i) => <g class="enter" style={`--delay:${i*100}ms`}><circle cx={80+i*140} cy="35" r="4" fill="#9ca3af"/><text x={80+i*140} y="20" text-anchor="middle">{label}</text></g>)}<g class="enter" style="--delay:300ms"><rect class="gold" x="95" y="85" width="250" height="35" rx="8"/><text x="220" y="107" text-anchor="middle">{ro ? "Sursă unică de adevăr" : "Single source of truth"}</text></g>{(ro ? ["Rapoarte","Dashboard-uri","Decizii"] : ["Reports","Dashboards","Decisions"]).map((label,i) => <g class="enter" style={`--delay:${500+i*100}ms`}><circle cx={80+i*140} cy="175" r="4" fill="#1f7a5c"/><text x={80+i*140} y="196" text-anchor="middle">{label}</text></g>)}</svg>}
  {key === "3-1" && <svg viewBox="0 0 440 210"><g class="lines"><path d="M115 55L220 105L325 55"/><path d="M115 155L220 105L325 155"/></g>{[0,1].map(i => <><circle cx="115" cy={55+i*100} r="5" fill="#9ca3af"/><text x="102" y={59+i*100} text-anchor="end">{ro ? "Sursă date" : "Source"} {i+1}</text><circle cx="325" cy={55+i*100} r="5" fill="#1f7a5c"/><text x="338" y={59+i*100}>{ro ? "Raport" : "Report"} {i+1}</text><circle class="flow" r="4" fill={i===0 ? "#e8b93f" : "#1f7a5c"} style={`offset-path:path('M115 ${55+i*100}L220 105L325 ${55+i*100}');animation-delay:${i*.6}s`}/></>)}<circle cx="220" cy="105" r="10" fill="#14213d"/><text x="220" y="140" text-anchor="middle">{ro ? "Sincronizare" : "Synchronisation"}</text></svg>}
  {key === "3-2" && <svg viewBox="0 0 440 210"><g class="enter">{[0,1,2].map(r => [0,1].map(c => <rect x={35+c*23} y={65+r*18} width="20" height="15"/>))}<text x="55" y="143" text-anchor="middle">{ro ? "Date brute" : "Raw data"}</text></g><path class="lines draw" d="M90 92H140M290 92H330"/><g class="enter" style="--delay:350ms"><rect class="gold" x="140" y="62" width="150" height="60" rx="8"/><text x="215" y="87" text-anchor="middle">{ro ? "Marjă =" : "Margin ="}</text><text x="215" y="109" text-anchor="middle">{ro ? "Profit ÷ Venituri" : "Profit ÷ Revenue"}</text></g>{[14,22,18,28,36].map((height,i) => <rect class="bar" style={`--delay:${650+i*90}ms`} x={335+i*12} y={112-height} width="8" height={height} fill="#1f7a5c"/>)}<text x="360" y="143" text-anchor="middle">{ro ? "KPI urmărit" : "Tracked KPI"}</text></svg>}
  {key === "3-3" && <svg viewBox="0 0 440 210">{(ro ? ["Board room","Dashboard","Parteneri","Clienți"] : ["Board room","Dashboard","Partners","Customers"]).map((label,i) => { const x=i%2===0 ? 100:340; const y=i<2?50:160; return <><path class="lines draw" d={`M220 105L${x} ${y}`}/><circle class="flow" r="4" fill="#e8b93f" style={`offset-path:path('M220 105L${x} ${y}');animation-delay:${i*.4}s`}/><g class="enter" style={`--delay:${i*100}ms`}><circle cx={x} cy={y} r="4" fill="#1f7a5c"/><text x={x} y={y+(i<2 ? -15:24)} text-anchor="middle">{label}</text></g></>; })}<circle cx="220" cy="105" r="22" fill="white" stroke="#14213d"/>{[[-8,-7],[6,-10],[-4,4],[8,6],[0,-1],[-11,3],[10,-3],[3,10]].map(([x,y]) => <circle cx={220+x} cy={105+y} r="2" fill="#e8b93f"/>)}</svg>}
</div>

<style>
  .animation { width:100%; min-width:0; min-height:170px; display:grid; place-items:center; color:#14213d; }
  [hidden] { display:none !important; }
  svg { display:block; width:100%; max-height:210px; overflow:visible; }
  svg text { font:11px ui-monospace,monospace; fill:#14213d; }
  svg rect { fill:#f7f7f5; stroke:#dcddd6; }
  svg rect.gold { fill:#f8efd4; stroke:#e8b93f; }
  .lines { fill:none; stroke:#dcddd6; stroke-width:1.5; }
  .enter,.report,.cloud span { animation:enter .45s both; animation-delay:var(--delay,0ms); }
  .cloud { display:flex; flex-wrap:wrap; justify-content:center; align-items:center; gap:10px 14px; text-align:center; }
  .cloud span { font:11px ui-monospace,monospace; animation:enter .4s both, float 3.6s ease-in-out infinite; animation-delay:var(--delay),var(--float-delay); }
  .cloud .major { font-size:21px; font-weight:700; }
  .reports { display:flex; gap:26px; text-align:center; }.report small { font:10px ui-monospace,monospace; }
  .sheet { width:65px; height:80px; background:white; border:1px solid #dcddd6; border-radius:6px; padding:12px 8px; margin-bottom:12px; }
  .sheet i { display:block; height:4px; background:#dcddd6; margin:7px 0; transform-origin:left; animation:grow .5s both; animation-delay:var(--delay); }
  .person { width:150px; }.ring { transform-box:fill-box; transform-origin:center; animation:ring 2.1s ease-out infinite; }
  .cycle { position:relative; width:100%; min-height:150px; }.cycle p { position:absolute; inset:0; display:grid; place-items:center; padding:12px; margin:0; opacity:0; text-align:center; font:500 18px/1.5 Georgia,serif; animation:cycle var(--cycle-duration) infinite; animation-delay:var(--cycle-delay); }.enrichment p { font:600 16px/1.5 ui-monospace,monospace; animation-name:cycle-four; }.cycle p:first-child { opacity:1; }
  .checklist { display:grid; gap:12px; width:150px; }.checklist div { display:flex; gap:14px; align-items:center; }.checklist svg { width:24px; }.checklist i { background:#e7e8e3; height:5px; border-radius:3px; flex:1; }.check { stroke-dasharray:1; stroke-dashoffset:1; animation:check 4s infinite; }
  .data-quality { display:flex; justify-content:center; gap:12px; width:100%; }.quality-piece { flex:1; min-width:0; text-align:center; }.quality-piece div { padding:10px 6px; border:1px solid #dcddd6; border-radius:6px; }.quality-piece div.warning { border-color:#e8b93f; background:#fbf7ee; }.quality-piece span { display:block; font:9px/1.8 ui-monospace,monospace; white-space:nowrap; }.quality-piece small { display:block; font:9px ui-monospace,monospace; margin-top:8px; }
  .flow { animation:flow 2.4s linear infinite; offset-distance:0%; }.orbit { transform-origin:220px 105px; animation:orbit 6s linear infinite; }
  .draw { stroke-dasharray:300; stroke-dashoffset:300; animation:draw 1s both; }.bar { transform-box:fill-box; transform-origin:bottom; animation:grow .5s both; animation-delay:var(--delay); stroke:none; fill:#1f7a5c; }
  @keyframes enter { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:translateY(0); } }
  @keyframes float { 0%,100% { transform:translate(0,0); } 50% { transform:translate(1px,-2px); } }
  @keyframes grow { from { transform:scale(0); } to { transform:scale(1); } }
  @keyframes ring { from { transform:scale(1); opacity:.9; } to { transform:scale(2.3); opacity:0; } }
  @keyframes cycle { 0%,27% { opacity:1; transform:translateY(0); } 31%,100% { opacity:0; transform:translateY(6px); } }
  @keyframes cycle-four { 0%,20% { opacity:1; transform:translateY(0); } 24%,100% { opacity:0; transform:translateY(6px); } }
  @keyframes check { 0% { stroke-dashoffset:1; } 15%,85% { stroke-dashoffset:0; } 100% { stroke-dashoffset:1; } }
  @keyframes flow { to { offset-distance:100%; } }
  @keyframes orbit { from { transform:rotate(0deg) translateX(80px); } to { transform:rotate(360deg) translateX(80px); } }
  @keyframes draw { to { stroke-dashoffset:0; } }
  @media(max-width:700px) { .data-quality { flex-wrap:wrap; }.quality-piece { flex:1 1 80px; }.quality-piece span { font-size:8px; }.reports { gap:18px; } svg text { font-size:12px; }.cloud .major { font-size:18px; } }
  @media(prefers-reduced-motion:reduce) { .animation :global(*) { animation:none !important; }.cycle p { display:none; }.cycle p:first-child { display:grid; opacity:1; }.check { stroke-dashoffset:0; }.draw { stroke-dashoffset:0; }.flow,.orbit,.ring { display:none; } }
</style>
