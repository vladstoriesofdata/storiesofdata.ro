---
import type { Locale } from "../../lib/site";
interface Props { locale: Locale; }
const { locale } = Astro.props;
// Original compact integration diagram, expressed in its 500 × 140 coordinate space.
const sources = [
  { x:80, y:25.2, img:"https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQUMDcW5SxE-Cnrobis1LC1dbtu2kMYhOGSbv_a4pm1Sc9HHbCMQILt5EBV&s=10", w:64, h:44 },
  { x:80, y:70, img:"https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQCeQTjQQVOJrtXderGlqJARfvdcvLYue4-7wEozEu8nFDy9wmcJ4u4efQ&s=10", w:64, h:44 },
  { x:80, y:114.8, img:"https://cdn.cookielaw.org/logos/80df487c-62ab-4978-b310-891309e09de5/8256719c-990a-4e5a-bbaf-94da03426ac4/447f9f6e-8d31-4a20-b31b-1bd91e5448b3/logo-general.png", w:70, h:40 },
  { x:180, y:25.2, img:"https://upload.wikimedia.org/wikipedia/commons/thumb/f/f9/Salesforce.com_logo.svg/960px-Salesforce.com_logo.svg.png", w:70, h:38 },
  { x:180, y:70, img:"https://upload.wikimedia.org/wikipedia/commons/thumb/5/59/SAP_2011_logo.svg/1280px-SAP_2011_logo.svg.png", w:58, h:34 },
  { x:180, y:114.8, img:null, w:0, h:0 },
];
---
<svg class="integration" viewBox="0 0 500 140" width="500" height="140" aria-hidden="true">
  <defs>
    <clipPath id="hubClipCompact"><circle cx="0" cy="0" r="26" /></clipPath>
    <marker id="arrowInCompact" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 Z" fill="#E8B93F" /></marker>
    <filter id="pulseGlowCompact" x="-100%" y="-100%" width="300%" height="300%"><feGaussianBlur stdDeviation="2" result="blur" /><feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge></filter>
  </defs>
  {sources.map((source,i) => <path id={`srcPath${i}`} fill="none" stroke="#E8B93F" stroke-width="1.4" stroke-dasharray="4 4" opacity="0.85" marker-end="url(#arrowInCompact)" d={`M${source.x+26},${source.y} L336,70`} />)}
  <g filter="url(#pulseGlowCompact)">
    {sources.map((_,i) => <circle class="pulse" r="3" fill="#E8B93F"><animateMotion dur="2.2s" begin={`${i*.35}s`} repeatCount="indefinite"><mpath href={`#srcPath${i}`} /></animateMotion></circle>)}
  </g>
  {sources.map((source,i) => <g class="source" transform={`translate(${source.x},${source.y})`} style={`animation-delay:${80+i*70}ms`}>
    <circle r="26" fill="#fff" stroke="#DCDDD6" stroke-width="1.5" stroke-dasharray="3 4" />
    {source.img ? <image href={source.img} x={-source.w/2} y={-source.h/2} width={source.w} height={source.h} preserveAspectRatio="xMidYMid meet" /> : <text text-anchor="middle" y="3">{locale === "ro" ? "Alte surse" : "Other sources"}</text>}
  </g>)}
  <g class="hub" transform="translate(370,70)">
    <circle r="34" fill="#fff" stroke="#E8B93F" stroke-width="2" />
    <image href="https://media.licdn.com/dms/image/v2/C560BAQEuUEFUnBOUfA/company-logo_200_200/company-logo_200_200/0/1662560274174/embedsy_logo?e=2147483647&v=beta&t=Clhsje2zPy-tEU5AGTgEj_CasYwXp6j9G-uyWhsp4xI" x="-24" y="-24" width="48" height="48" clip-path="url(#hubClipCompact)" preserveAspectRatio="xMidYMid meet" />
  </g>
</svg>
<style>
  .integration { display:block; width:100%; height:auto; overflow:visible; }
  text { font:10.5px 'IBM Plex Mono',monospace; fill:#14213D; }
  .source,.hub { opacity:0; animation:appear .3s cubic-bezier(.645,.045,.355,1) forwards; }
  .hub { animation-delay:500ms; }
  @keyframes appear { to { opacity:1; } }
  @media(prefers-reduced-motion:reduce) { .pulse { display:none; }.source,.hub { animation:none; opacity:1; } }
</style>
