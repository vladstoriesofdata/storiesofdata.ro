---
import { getSiteConfig } from "../../lib/site";
import { team } from "../../data/team";
import LottieGraphic from "./LottieGraphic.astro";
import connectedDots from "../../assets/lottie/connected-dots-loop.json?url";

const site = getSiteConfig(import.meta.env);
const copy = team[site.locale];
---
<section
  id="team"
  class="section home-section"
  data-section-name="our-team"
  aria-labelledby="team-heading"
>
  <div class="section-lottie" aria-hidden="true">
    <LottieGraphic src={connectedDots} loop={false} autoplay={false} />
  </div>
  <h2 id="team-heading">{copy.heading}</h2>
  {copy.members.map((member) => (
    <article>
      <h3>{member.name}</h3>
      <p class="role">{member.role}</p>
      {member.bio.split("\n\n").map((paragraph) => (
        <p>{paragraph}</p>
      ))}
      <p>
        <a href={`mailto:${member.email}`}>{member.email}</a>
      </p>
    </article>
  ))}
</section>

<style>
  article + article {
    margin-top: 2rem;
  }

  .role {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
</style>
