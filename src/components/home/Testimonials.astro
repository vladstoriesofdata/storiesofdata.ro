---
import { getSiteConfig } from "../../lib/site";
import { testimonials, testimonialMapPins } from "../../data/testimonials";
import TestimonialCard from "./TestimonialCard.astro";
import worldMap from "../../assets/testimonials/world-map.svg";
import worldMapMobile from "../../assets/testimonials/world-map-mobile.svg";
import jess from "../../assets/testimonials/jess-cary.png";
import joshua from "../../assets/testimonials/joshua-chernikoff.png";
import timo from "../../assets/testimonials/timo-pentner.png";
import balancePoint from "../../assets/testimonials/balance-point-logo.png";
import flexAcademies from "../../assets/testimonials/flex-academies-logo.png";
import flowTraders from "../../assets/testimonials/flow-traders-logo.svg";

const site = getSiteConfig(import.meta.env);
const copy = testimonials[site.locale];

const photos = {
  jess,
  joshua,
  timo,
} as const;

const logos = {
  balancepoint: balancePoint,
  flex: flexAcademies,
  flowtraders: flowTraders,
} as const;

const DESKTOP_PAGE_SIZE = 2;
const desktopPages = Array.from(
  { length: Math.ceil(copy.items.length / DESKTOP_PAGE_SIZE) },
  (_, index) => copy.items.slice(index * DESKTOP_PAGE_SIZE, (index + 1) * DESKTOP_PAGE_SIZE),
);
---
<section
  id="testimonials"
  class="section home-section testimonials-section"
  data-section-name="testimonials"
  aria-labelledby="testimonials-heading"
>
  <h2 id="testimonials-heading" class="testimonials-heading">{copy.heading}</h2>
  {copy.translationNote && <p class="testimonials-translation-note">{copy.translationNote}</p>}
  <img
    class="testimonials-map-mobile"
    src={worldMapMobile.src}
    alt=""
    width={worldMapMobile.width}
    height={worldMapMobile.height}
  />
  <div class="section-lottie testimonials-map-wrapper">
    <div class="testimonials-map-frame">
      <img
        class="testimonials-map-img"
        src={worldMap.src}
        alt=""
        width={worldMap.width}
        height={worldMap.height}
      />
      <div class="testimonials-map-dots">
        {testimonialMapPins.map((pin) => (
          <button
            type="button"
            class:list={["testimonials-map-dot", pin.compact && "is-compact"]}
            style={`--dot-size: ${pin.size}; --dot-top: ${pin.top}; --dot-left: ${pin.left};`}
            aria-label={`${pin.company}, ${pin.location}`}
          >
            <span class="testimonials-map-popup">
              <span class="testimonials-map-company">{pin.company}</span>
              <span class="testimonials-map-location">{pin.location}</span>
              <span class="testimonials-map-caret"></span>
            </span>
          </button>
        ))}
      </div>
    </div>
  </div>
  <div class="testimonials-carousel testimonials-carousel-desktop" data-carousel>
    {desktopPages.map((page, pageIndex) => (
      <div class="testimonials-slide" data-slide hidden={pageIndex !== 0}>
        {page.map((item) => (
          <TestimonialCard item={item} photo={photos[item.person]} logo={logos[item.logo]} />
        ))}
      </div>
    ))}
    {desktopPages.length > 1 && (
      <div class="testimonials-carousel-dots">
        {desktopPages.map((_, pageIndex) => (
          <button
            type="button"
            class="testimonials-carousel-dot"
            data-carousel-dot={String(pageIndex)}
            aria-label={`Show testimonials page ${pageIndex + 1}`}
            aria-current={pageIndex === 0 ? "true" : "false"}
          />
        ))}
      </div>
    )}
  </div>
  <div class="testimonials-carousel testimonials-carousel-mobile" data-carousel>
    {copy.items.map((item, index) => (
      <div class="testimonials-slide" data-slide hidden={index !== 0}>
        <TestimonialCard item={item} photo={photos[item.person]} logo={logos[item.logo]} />
      </div>
    ))}
    {copy.items.length > 1 && (
      <div class="testimonials-carousel-dots">
        {copy.items.map((item, index) => (
          <button
            type="button"
            class="testimonials-carousel-dot"
            data-carousel-dot={String(index)}
            aria-label={`Show testimonial from ${item.name}`}
            aria-current={index === 0 ? "true" : "false"}
          />
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .testimonials-translation-note {
    margin: 0.25rem 0 0;
    color: var(--color-muted);
    font-size: 0.75rem;
  }
</style>
