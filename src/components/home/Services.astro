---
import { BOOKINGS_URL, services } from "../../data/services";
import { getSiteConfig } from "../../lib/site";
import ServiceVisual from "./services/ServiceVisual.astro";

const site = getSiteConfig(import.meta.env);
const copy = services[site.locale];
---
<section
  id="services"
  class="section home-section services-section"
  data-section-name="services-and-products"
  aria-labelledby="services-heading"
>
  <div class="services-stage" data-services data-services-mode="desktop">
    <div class="services-stage-heading">
      <h2 id="services-heading">{copy.heading}</h2>
      <div class="services-stage-controls" role="tablist" data-services-controls aria-label={copy.heading}>
        {copy.items.map((item, index) => {
          const active = index === 0;
          return (
            <button
              type="button"
              class="services-tab"
              role="tab"
              id={`services-tab-${item.id}`}
              data-service-control={item.id}
              aria-selected={active ? "true" : "false"}
              aria-controls={`services-panel-${item.id}`}
              tabindex={active ? 0 : -1}
            >
              {item.tabLabel}
            </button>
          );
        })}
      </div>
    </div>

    <div class="services-stage-panels">
      {copy.items.map((item, index) => (
        <section
          class="services-panel"
          role="tabpanel"
          id={`services-panel-${item.id}`}
          data-service-panel={item.id}
          aria-labelledby={`services-tab-${item.id}`}
          hidden={index !== 0}
        >
          <div class="services-panel-grid">
            <div class="services-stage-copy">
              <h3>{item.headline}</h3>
              <p class="services-stage-summary">{item.summary}</p>
              <ul class="services-stage-benefits">
                {item.benefits.map((benefit) => (
                  <li>{benefit}</li>
                ))}
              </ul>
              <div class="services-stage-actions">
                <a class="pill-button" href={BOOKINGS_URL}>{item.primaryCta}</a>
                {item.exploration.url && (
                  <a class="services-stage-exploration" href={item.exploration.url}>
                    {item.exploration.label}
                  </a>
                )}
              </div>
            </div>
            <div class="services-stage-visual">
              <ServiceVisual service={item} />
            </div>
          </div>
        </section>
      ))}
    </div>
  </div>
</section>

<script>
  import { initServicesInteraction } from "./ServicesInteraction";

  initServicesInteraction();
</script>
