<div class="cfo-visual" data-cfo-visual data-active-capability="clarity">
  <p class="eyebrow">CFO + BI, joined up</p>
  <div class="cfo-map" aria-label="Connected CFO and business intelligence capabilities">
    <div class="connections" aria-hidden="true"><span class="horizontal"></span><span class="vertical"></span><span class="diagonal-a"></span><span class="diagonal-b"></span></div>
    <button type="button" aria-pressed="true" data-capability="clarity" data-example="A weekly view of cash, margin and the decisions changing both.">Financial clarity</button>
    <button type="button" aria-pressed="false" data-capability="leadership" data-example="A fractional CFO turns the numbers into a plan your leadership team can use.">Fractional CFO leadership</button>
    <button type="button" aria-pressed="false" data-capability="data" data-example="Shared measures make every review start from the same trusted facts.">Reliable business data</button>
    <button type="button" aria-pressed="false" data-capability="platform" data-example="A connected platform keeps financial and operational signals in the same conversation.">Intelligent data platform</button>
  </div>
  <div class="cfo-example" aria-live="polite"><span>Example</span><p data-cfo-example>A weekly view of cash, margin and the decisions changing both.</p></div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-cfo-visual]").forEach((root) => {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-capability]")];
    const example = root.querySelector<HTMLElement>("[data-cfo-example]");

    const selectCapability = (button: HTMLButtonElement) => {
      root.dataset.activeCapability = button.dataset.capability ?? "";
      buttons.forEach((capability) => capability.setAttribute("aria-pressed", String(capability === button)));
      if (example) example.textContent = button.dataset.example ?? "";
    };

    buttons.forEach((button) => button.addEventListener("click", () => selectCapability(button)));
  });
</script>

<style>
  .cfo-visual { display: grid; grid-template-rows: auto 1fr auto; gap: clamp(1rem, 4vw, 2rem); min-height: 100%; font-family: var(--font-sans); }.eyebrow { margin: 0; color: var(--color-muted); font-family: var(--font-display); font-size: 0.95rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
  .cfo-map { position: relative; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1rem, 5vw, 3rem); padding: 1rem 0; }.connections { position: absolute; inset: 1rem 15%; pointer-events: none; }.connections span { position: absolute; top: 50%; left: 0; width: 100%; height: 1px; background: color-mix(in srgb, var(--color-ink) 42%, transparent); transform-origin: center; }.connections .vertical { transform: rotate(90deg); }.connections .diagonal-a { transform: rotate(27deg); }.connections .diagonal-b { transform: rotate(-27deg); }
  .cfo-map button { z-index: 1; min-height: 6.6rem; padding: 1rem; border: 1px solid var(--color-ink); background: var(--color-paper); color: var(--color-ink); font-family: var(--font-display); font-size: clamp(1.05rem, 2.1vw, 1.55rem); font-weight: 800; line-height: 0.95; text-align: left; cursor: pointer; }.cfo-map button:hover, .cfo-map button[aria-pressed="true"] { background: var(--color-accent); }.cfo-map button:focus-visible { outline: 3px solid var(--color-ink); outline-offset: 3px; }
  .cfo-example { display: grid; grid-template-columns: auto 1fr; gap: 0.75rem; align-items: baseline; padding-top: 1rem; border-top: 1px solid color-mix(in srgb, var(--color-ink) 24%, transparent); }.cfo-example span { color: var(--color-muted); font-family: var(--font-display); font-size: 0.8rem; font-weight: 800; letter-spacing: 0.07em; text-transform: uppercase; }.cfo-example p { margin: 0; font-size: clamp(0.85rem, 1.55vw, 1rem); line-height: 1.4; }
  .cfo-visual[data-active-capability] .connections span { background: var(--color-ink); }.cfo-visual[data-active-capability] .connections .diagonal-a, .cfo-visual[data-active-capability] .connections .diagonal-b { background: var(--color-accent); height: 2px; }
  @media (max-width: 480px) { .cfo-map { gap: 0.85rem; }.cfo-map button { min-height: 5.2rem; padding: 0.75rem; }.connections { inset: 0.8rem 13%; }.cfo-example { grid-template-columns: 1fr; gap: 0.25rem; } }
  @media (prefers-reduced-motion: no-preference) { .cfo-map button, .connections span { transition: background-color 160ms ease; } }
</style>
