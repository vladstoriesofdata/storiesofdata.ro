---
interface Props {
  src: string;
  loop?: boolean;
  autoplay?: boolean;
  scrub?: boolean;
  preserveAspectRatio?: string;
  class?: string;
  when?: "desktop" | "mobile" | "always";
}

const {
  src,
  loop = false,
  autoplay = false,
  scrub = false,
  preserveAspectRatio,
  class: className,
  when = "always",
} = Astro.props;
---
<div
  class:list={["lottie-graphic", className]}
  data-lottie
  data-src={src}
  data-loop={loop ? "1" : "0"}
  data-autoplay={autoplay ? "1" : "0"}
  data-scrub={scrub ? "1" : "0"}
  data-preserve-aspect-ratio={preserveAspectRatio}
  data-lottie-when={when}
></div>

<script>
  import { initLottieGraphics } from "./lottieGraphics";
  initLottieGraphics();
</script>

<style>
  .lottie-graphic {
    width: 100%;
    height: 100%;
  }

  .lottie-graphic :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
