---
import { home } from "../../data/home";
import { getSiteConfig } from "../../lib/site";
import { PORTFOLIO_STRIP_TABS } from "../../data/portfolioStrip";
import LottieGraphic from "./LottieGraphic.astro";
import PortfolioCard from "./PortfolioCard.astro";
import portfolioZoom from "../../assets/lottie/portfolio-zoom.json?url";

const site = getSiteConfig(import.meta.env);
const copy = home[site.locale];
const PAGE_SIZE = 4;

function chunk<T>(items: T[], size: number): T[][] {
  const pages: T[][] = [];
  for (let i = 0; i < items.length; i += size) {
    pages.push(items.slice(i, i + size));
  }
  return pages;
}

const tabs = PORTFOLIO_STRIP_TABS.map((tab) => ({
  ...tab,
  pages: chunk(tab.items, PAGE_SIZE),
}));
---
<section
  id="portfolio"
  class="section home-section portfolio-section"
  data-section-name="portfolio"
  aria-labelledby="portfolio-heading"
>
  <div class="section-lottie" aria-hidden="true">
    <LottieGraphic src={portfolioZoom} loop={true} autoplay={true} preserveAspectRatio="xMidYMid slice" />
  </div>
  <h2 id="portfolio-heading" class="visually-hidden">{copy.portfolio.heading}</h2>
  <div class="portfolio-tabs" data-tabs>
    <div class="portfolio-tablist" role="tablist" aria-label={copy.portfolio.heading}>
      {tabs.map((tab, index) => {
        const selected = index === 0;
        return (
          <button
            type="button"
            class="portfolio-tab"
            role="tab"
            id={`portfolio-tab-${tab.id}`}
            data-tab={tab.id}
            aria-selected={selected ? "true" : "false"}
            aria-controls={`portfolio-panel-${tab.id}`}
            tabindex={selected ? 0 : -1}
          >
            {tab.label}
          </button>
        );
      })}
    </div>
    {tabs.map((tab, index) => (
      <div
        class="portfolio-panel"
        role="tabpanel"
        id={`portfolio-panel-${tab.id}`}
        data-tab-panel={tab.id}
        aria-labelledby={`portfolio-tab-${tab.id}`}
        hidden={index !== 0}
      >
        <div class="portfolio-carousel portfolio-carousel-desktop" data-carousel>
          {tab.pages.map((page, pageIndex) => (
            <div class="portfolio-grid" data-slide hidden={pageIndex !== 0}>
              {page.map((entry) => (
                <PortfolioCard
                  href={`${entry.hrefBase}/${entry.slug}`}
                  title={entry.title}
                  description={entry.description}
                  cover={entry.cover}
                  fit={entry.fit}
                />
              ))}
            </div>
          ))}
          {tab.pages.length > 1 && (
            <div class="portfolio-carousel-controls">
              <button type="button" class="portfolio-carousel-btn" data-carousel-prev>
                Previous
              </button>
              <div class="portfolio-carousel-dots">
                {tab.pages.map((_, pageIndex) => (
                  <button
                    type="button"
                    class="portfolio-carousel-dot"
                    data-carousel-dot={String(pageIndex)}
                    aria-label={`Show page ${pageIndex + 1} of ${tab.label}`}
                  />
                ))}
              </div>
              <button type="button" class="portfolio-carousel-btn" data-carousel-next>
                Next
              </button>
            </div>
          )}
        </div>
        <div class="portfolio-carousel portfolio-carousel-mobile" data-carousel>
          {tab.items.map((entry, slideIndex) => (
            <PortfolioCard
              href={`${entry.hrefBase}/${entry.slug}`}
              title={entry.title}
              description={entry.description}
              cover={entry.cover}
              fit={entry.fit}
              slide
              hidden={slideIndex !== 0}
            />
          ))}
          {tab.items.length > 1 && (
            <div class="portfolio-carousel-controls">
              <button type="button" class="portfolio-carousel-btn" data-carousel-prev>
                Previous
              </button>
              <div class="portfolio-carousel-dots">
                {tab.items.map((entry, slideIndex) => (
                  <button
                    type="button"
                    class="portfolio-carousel-dot"
                    data-carousel-dot={String(slideIndex)}
                    aria-label={`Show ${entry.title}`}
                  />
                ))}
              </div>
              <button type="button" class="portfolio-carousel-btn" data-carousel-next>
                Next
              </button>
            </div>
          )}
        </div>
      </div>
    ))}
  </div>
</section>
