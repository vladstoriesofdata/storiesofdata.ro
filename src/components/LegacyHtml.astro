---
import {
  enhanceAnalyticsLayout,
  resolveLegacyImages,
} from "../lib/resolveLegacyImages";

interface Props {
  html: string;
}

const { html } = Astro.props;
const resolved = enhanceAnalyticsLayout(
  resolveLegacyImages(html, Astro.url.pathname),
);
---
<div class="legacy-html" set:html={resolved} />
