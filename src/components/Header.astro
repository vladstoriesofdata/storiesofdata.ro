---
import LanguageSwitch from "./LanguageSwitch.astro";
import { getSiteConfig } from "../lib/site";
import { navigation } from "../data/navigation";
import { sectionNameFromHash } from "./home/SectionSnap";
import logoBlack from "../assets/brand/logo-black.svg";

interface Props {
  path: string;
}

const { path } = Astro.props;
const site = getSiteConfig(import.meta.env);
const isHome = path === "/";
const links = navigation[site.locale];
---
<header data-home={isHome ? "1" : undefined}>
  <a href="/" class="brand">
    <img
      src={logoBlack.src}
      alt={site.name}
      width={logoBlack.width}
      height={logoBlack.height}
    />
  </a>
  <nav>
    {links.map((item) => {
      const href = isHome ? item.homeHref : item.href;
      const section = isHome ? sectionNameFromHash(item.homeHref) : undefined;
      return (
        <a href={href} data-section-target={section}>{item.label}</a>
      );
    })}
    <LanguageSwitch path={path} />
  </nav>
</header>

<script>
  document.querySelector("header")?.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const link = target.closest("a[data-section-target]");
    if (!(link instanceof HTMLAnchorElement)) return;
    const name = link.dataset.sectionTarget;
    if (!name || typeof window.__homepageMoveTo !== "function") return;
    event.preventDefault();
    window.__homepageMoveTo(name);
  });
</script>

<style>
  .brand img {
    display: block;
    height: 2.5rem;
    width: auto;
  }
</style>
