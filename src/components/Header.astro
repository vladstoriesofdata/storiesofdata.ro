---
import LanguageSwitch from "./LanguageSwitch.astro";
import { getSiteConfig } from "../lib/site";
import { navigation } from "../data/navigation";
import logoBlack from "../assets/brand/logo-black.svg";

interface Props {
  path: string;
}

const { path } = Astro.props;
const site = getSiteConfig(import.meta.env);
const isHome = path === "/";
const links = navigation[site.locale];
---
<header>
  <a href="/" class="brand">
    <img
      src={logoBlack.src}
      alt={site.name}
      width={logoBlack.width}
      height={logoBlack.height}
    />
  </a>
  <nav>
    {links.map((item) => (
      <a href={isHome ? item.homeHref : item.href}>{item.label}</a>
    ))}
    <LanguageSwitch path={path} />
  </nav>
</header>

<style>
  .brand img {
    display: block;
    height: 2.5rem;
    width: auto;
  }
</style>
