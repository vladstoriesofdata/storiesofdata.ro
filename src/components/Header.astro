---
import LanguageSwitch from "./LanguageSwitch.astro";
import WorkMenu from "./work/WorkMenu.astro";
import { getSiteConfig } from "../lib/site";
import { navigation } from "../data/navigation";
import { sectionNameFromHash } from "./home/SectionSnap";
import logoBlack from "../assets/brand/logo-black.svg";
import logoWhite from "../assets/brand/logo-white.svg";
import logoMark from "../assets/brand/logo-mark.svg";

type Chrome = "home" | "work" | "doc";

interface Props {
  path: string;
  chrome?: Chrome;
}

const { path, chrome = "doc" } = Astro.props;
const site = getSiteConfig(import.meta.env);
const links = navigation[site.locale];
---

{chrome === "home" && (
  <header class="site-header home-chrome">
    <div class="home-chrome-top">
      <a href="/" class="brand">
        <img
          class="brand-logo brand-logo-black"
          src={logoBlack.src}
          alt={site.name}
          width={logoBlack.width}
          height={logoBlack.height}
        />
        <img
          class="brand-logo brand-logo-white"
          src={logoWhite.src}
          alt=""
          width={logoWhite.width}
          height={logoWhite.height}
          aria-hidden="true"
        />
      </a>
      <LanguageSwitch path={path} />
    </div>
    <button
      type="button"
      class="home-menu-toggle"
      aria-expanded="false"
      aria-controls="home-nav"
    >
      menu
    </button>
    <nav id="home-nav">
      {links.map((item) => {
        const href = item.homeHref;
        const section = sectionNameFromHash(item.homeHref);
        return (
          <a href={href} data-section-target={section}>{item.label}</a>
        );
      })}
    </nav>
  </header>
)}

{chrome === "work" && (
  <>
    <header class="site-header work-chrome">
      <div class="work-chrome-top">
        <a href="/" class="brand">
          <img
            src={logoMark.src}
            alt={site.name}
            width={logoMark.width}
            height={logoMark.height}
          />
        </a>
        <LanguageSwitch path={path} />
      </div>
      <button
        type="button"
        class="work-menu-toggle"
        aria-expanded="false"
        aria-controls="work-menu"
      >
        menu
      </button>
    </header>
    <WorkMenu path={path} />
  </>
)}

{chrome === "doc" && (
  <header class="site-header doc-chrome">
    <a href="/" class="brand">
      <img
        src={logoBlack.src}
        alt={site.name}
        width={logoBlack.width}
        height={logoBlack.height}
      />
    </a>
    <LanguageSwitch path={path} />
  </header>
)}

<script>
  document.querySelector("header")?.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const link = target.closest("a[data-section-target]");
    if (!(link instanceof HTMLAnchorElement)) return;
    const name = link.dataset.sectionTarget;
    if (!name || typeof window.__homepageMoveTo !== "function") return;
    event.preventDefault();
    window.__homepageMoveTo(name);
  });

  document.querySelector(".home-menu-toggle")?.addEventListener("click", () => {
    const header = document.querySelector("header.home-chrome");
    const button = document.querySelector(".home-menu-toggle");
    if (!(header instanceof HTMLElement) || !(button instanceof HTMLButtonElement)) return;
    const open = button.getAttribute("aria-expanded") !== "true";
    button.setAttribute("aria-expanded", String(open));
    header.classList.toggle("is-open", open);
  });

  const workToggle = document.querySelector(".work-menu-toggle");
  const workMenu = document.querySelector("#work-menu");
  const workOverlay = document.querySelector(".work-menu-overlay");

  const setWorkMenuOpen = (open: boolean) => {
    if (!(workToggle instanceof HTMLButtonElement) || !(workMenu instanceof HTMLElement)) return;
    workToggle.setAttribute("aria-expanded", String(open));
    workMenu.hidden = !open;
  };

  workToggle?.addEventListener("click", () => {
    if (!(workToggle instanceof HTMLButtonElement)) return;
    setWorkMenuOpen(workToggle.getAttribute("aria-expanded") !== "true");
  });
  workOverlay?.addEventListener("click", () => setWorkMenuOpen(false));
</script>
