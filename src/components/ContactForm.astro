---
import { getSiteConfig, withBase } from "../lib/site";
import { home } from "../data/home";

const site = getSiteConfig(import.meta.env);
const copy = home[site.locale].form;
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT;
const disabled = !endpoint;
---
<form class="contact-form" method="POST" action={endpoint || "#contact"} aria-disabled={disabled}>
  <label class="contact-field">
    {copy.name}
    <input name="name" required disabled={disabled} placeholder="Your Name" />
  </label>
  <label class="contact-field">
    {copy.email}
    <input type="email" name="email" required disabled={disabled} placeholder="your@company.com" />
  </label>
  <label class="contact-field contact-field-message">
    {copy.message}
    <textarea
      name="message"
      required
      disabled={disabled}
      placeholder={copy.messagePlaceholder}></textarea>
  </label>
  <p class="contact-privacy">
    <label>
      <input type="checkbox" name="privacy" required disabled={disabled} />
      {copy.privacy}
    </label>
    <a href={withBase("/privacy-policy", import.meta.env.BASE_URL)}>{copy.privacyLink}</a>.
  </p>
  <button class="pill-button contact-submit" type="submit" disabled={disabled}>{copy.submit}</button>
  {disabled && <p class="contact-unconfigured">{copy.unconfigured}</p>}
</form>
