---
import { getSiteConfig, withBase } from "../../lib/site";
import type { AdjacentNav } from "../../lib/collections";
import { ui } from "../../data/ui";

interface Props {
  nav: AdjacentNav;
  kindLabel: string;
}

const { nav, kindLabel } = Astro.props;
const site = getSiteConfig(import.meta.env);
const copy = ui[site.locale];
const prevHref = withBase(nav.prev.href, import.meta.env.BASE_URL);
const nextHref = withBase(nav.next.href, import.meta.env.BASE_URL);
---
<nav class="post-pager" aria-label={copy.postNavigation}>
  <a class="post-pager-btn prev" href={prevHref} aria-label={copy.previous}>{copy.previous}</a>
  <p class="post-pager-count">
    <span class="post-pager-kind">{kindLabel}</span>
    <span class="post-pager-index">{nav.index}</span>
    <span>/</span>
    <span class="post-pager-total">{nav.total}</span>
  </p>
  <a class="post-pager-btn next" href={nextHref} aria-label={copy.next}>{copy.next}</a>
</nav>
