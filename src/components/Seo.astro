---
import { getSiteConfig, hreflangLinks, absoluteUrl, absoluteAssetUrl } from "../lib/site";
import logoBlack from "../assets/brand/logo-black.svg";
import ogDefault from "../assets/brand/og-default.jpg";

interface Props {
  title: string;
  description: string;
  path: string;
  robots?: string;
}

const { title, description, path, robots } = Astro.props;
const site = getSiteConfig(import.meta.env);
const canonical = absoluteUrl(path, site);
const alternates = hreflangLinks(path, site);
const ogImage = absoluteAssetUrl(ogDefault.src, site);
const logoUrl = absoluteAssetUrl(logoBlack.src, site);
const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: site.name,
  url: site.url,
  logo: logoUrl,
};
---
<title>{title}</title>
<meta name="description" content={description} />
{robots && <meta name="robots" content={robots} />}
<link rel="canonical" href={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content="website" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content={String(ogDefault.width)} />
<meta property="og:image:height" content={String(ogDefault.height)} />
{alternates.map((link) => (
  <link rel="alternate" hreflang={link.lang} href={link.href} />
))}
<script type="application/ld+json" set:html={JSON.stringify(organization)} />
