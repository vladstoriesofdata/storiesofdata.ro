---
const iubendaEnabled = Boolean(
  import.meta.env.PUBLIC_IUBENDA_SITE_ID && import.meta.env.PUBLIC_IUBENDA_POLICY_ID,
);
const gaId = iubendaEnabled ? import.meta.env.PUBLIC_GA_ID : "";
const clarityId = iubendaEnabled ? import.meta.env.PUBLIC_CLARITY_ID : "";
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;

const gaConfigScript = gaId
  ? `window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', ${JSON.stringify(gaId)});`
  : "";

const clarityScript = clarityId
  ? `(function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", ${JSON.stringify(clarityId)});`
  : "";
---
{googleVerification && (
  <meta name="google-site-verification" content={googleVerification} />
)}
{gaId && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
    <script is:inline set:html={gaConfigScript} />
  </>
)}
{clarityId && <script is:inline set:html={clarityScript} />}
